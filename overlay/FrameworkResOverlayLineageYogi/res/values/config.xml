<?xml version="1.0" encoding="utf-8"?>
<!-- Ours, not recovered from stock. EuiccSupportPixel registers a content observer on
     Google Services Framework at startup, so without GMS it throws and restarts in a
     loop. It does eUICC firmware and applet updates, not profile management, so the
     eSIM works without it; silencing the report just stops the crash dialog. -->
<resources>
    <string name="config_appsNotReportingCrashes">com.google.android.euicc</string>

    <!-- Surface the stock-hidden developer option that controls desktop mode. -->
    <bool name="config_isDesktopModeDevOptionSupported">true</bool>

    <!-- Deliberately overrides the stock-ported true in FrameworkResOverlayVendorYogi. -->
    <bool name="config_isDesktopModeSupported">false</bool>

    <!-- Empty on purpose. DerpFest's default certified props are a Pixel 10 Pro XL
         (mustang) identity, which Play Store reports until a PIF is imported, and the
         device packs delivered on that basis crash Google Camera at startup. With the
         array empty Play reports this build's own identity instead. Inert on LineageOS,
         whose framework does not declare the resource. -->
    <string-array name="config_certifiedBuildProperties" />
</resources>
