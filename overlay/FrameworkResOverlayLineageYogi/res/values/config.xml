<?xml version="1.0" encoding="utf-8"?>
<!-- Ours, not recovered from stock. EuiccSupportPixel registers a content observer on
     Google Services Framework at startup, so without GMS it throws and restarts in a
     loop. It does eUICC firmware and applet updates, not profile management, so the
     eSIM works without it; silencing the report just stops the crash dialog. -->
<resources>
    <string name="config_appsNotReportingCrashes">com.google.android.euicc</string>

    <!-- Surface the stock-hidden developer option that controls desktop mode. -->
    <bool name="config_isDesktopModeDevOptionSupported">true</bool>

    <!-- Deliberately overrides the stock-ported true in FrameworkResOverlayVendorYogi. -->
    <bool name="config_isDesktopModeSupported">false</bool>

    <!-- Fetch the certified props from our own fork, which serves this
         device's real identity generated from the current stock OTA.
         The upstream default is a Pixel 10 Pro XL, which Play delivers
         mustang device packs for. -->
    <string name="config_pifUpdateUrl" translatable="false">https://raw.githubusercontent.com/asdfmonster261/android_vendor_certification/17/gms_certified_props.json</string>

    <!-- The device's own stable identity, in place of DerpFest's Pixel 10 Pro XL
         default, which made Play deliver mustang device packs that crash Google
         Camera at startup. The spoof therefore reports this build as itself. Fields
         that change with every OTA (fingerprint, build ID, incremental) are left to
         the build props, which already carry them. -->
    <string-array name="config_certifiedBuildProperties">
        <item>MANUFACTURER:Google</item>
        <item>MODEL:Pixel 11 Pro Fold</item>
        <item>BRAND:google</item>
        <item>PRODUCT:yogi</item>
        <item>DEVICE:yogi</item>
        <item>HARDWARE:yogi</item>
        <item>VERSION.RELEASE:17</item>
        <item>TYPE:user</item>
        <item>TAGS:release-keys</item>
        <item>VERSION.DEVICE_INITIAL_SDK_INT:37</item>
    </string-array>
</resources>
